  "projects": [
    {
      "title": "2D Visualization of Incompressible Flow Through Machine Learning",
      "meta": "Thesis, 2024",
      "img": "https://dfrlugnqaekgerfhtjra.supabase.co/storage/v1/object/public/site-media/projects/2026/834a6a85-dcb2-457b-844a-753dcc4efab2.webp",
      "text": "Combines machine learning with traditional computational fluid dynamics to predict fluid flow in mechanical systems. It explores hybrid approaches that reduce computational cost and benchmarks them against conventional methods.",
      "people": [
        [
          "Thesis partner",
          "Waqar Habib Noman (ME, BUET)"
        ],
        [
          "Supervisor",
          "Dr. Mohammad Mamun, Professor, Dept. of Mechanical Engineering, BUET"
        ]
      ],
      "tools": [
        "Python"
      ],
      "links": [
        {
          "url": "https://docs.google.com/presentation/d/1LnT7AgzHQjLQQ3WkvFlMv9DivzCXVtuy/edit?usp=drive_link",
