        },
        {
          "url": "https://drive.google.com/file/d/1qlQhNqVeuoOJddJkJk48yo9joMh7c4ba/view?usp=drive_link",
          "label": "Dissertation"
        }
      ]
    },
    {
      "title": "MHD Free Convection with Joule Heating and Entropy Generation inside an H-shaped Chamber",
      "meta": "Journal paper, Heliyon, 2023",
      "img": "https://dfrlugnqaekgerfhtjra.supabase.co/storage/v1/object/public/site-media/projects/2026/16637469-91b9-4f76-a192-1e93daa6305c.webp",
      "text": "Numerical study of natural convection of water in an H-shaped chamber under a magnetic field and Joule heating, varying Rayleigh and Hartmann numbers. Heat transfer is assessed through Nusselt numbers, temperature, entropy generation and thermal criteria, with streamlines and isotherms showing the flow.",
      "people": [
        [
          "Research partners",
          "Riyan Hashem Jamy (ME, BUET) & Md Shahneoug Shuvo (ME, BUET)"
        ],
        [
          "Supervisor",
          "Dr. Sumon Saha, Professor, Dept. of Mechanical Engineering, BUET"
        ]
      ],
      "tools": [
        "Comsol"
      ],
      "links": [
        {
          "url": "https://www.cell.com/heliyon/fulltext/S2405-8440(24)05411-2",
          "label": "Read the paper"
        }
      ]
    },
    {
      "title": "Air Conditioner Using Peltier Module",
      "meta": "Project, 2023",
      "img": "https://dfrlugnqaekgerfhtjra.supabase.co/storage/v1/object/public/site-media/projects/2026/9a3a4673-88e9-4d99-9e6a-35a4d8dfa7b5.webp",
      "text": "An air conditioner built on a thermoelectric (Peltier) module and locally available parts. Covers module, fin, fan motor and pump selection, circuit design, SolidWorks modelling and an economic analysis for manufacturing.",
      "people": [
        [
          "Partners",
          "Shorup Chanda (ME, BUET) & Riyan Hashem Jamy (ME, BUET)"
        ]
      ],
      "links": [
        {
          "url": "https://www.researchgate.net/publication/370659755_Air_Conditioner_Using_Peltier_Module",
          "label": "ResearchGate"
        }
      ]
    },
    {
      "title": "Cooling Load Estimation",
      "meta": "Project, 2023",
      "img": "https://dfrlugnqaekgerfhtjra.supabase.co/storage/v1/object/public/site-media/projects/2026/31ac01fe-86cb-45ce-8301-547ac565ff58.webp",
      "text": "Models a room in SolidWorks and estimates its cooling load from climate data, covering conduction, solar radiation, infiltration and internal gains. Ends with the refrigeration tonnage needed, documented in a LaTeX report.",
      "tools": [
        "Solidworks",
        "LaTex",
        "Github"
      ],
      "links": [
